# Database
DATABASE_URL=postgresql://video_user:video_password@localhost:5433/video_analyzer

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production

# Anthropic API (Claude Vision)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Cloudflare R2 Storage
R2_ENDPOINT_URL=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=video-analyzer-videos

# R2 Buckets
R2_BENCHMARKS_BUCKET=video-analyzer-benchmarks
R2_USER_VIDEOS_BUCKET=video-analyzer-user-videos

# Security
ENCRYPTION_KEY=generate-with-fernet-generate-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
